{
    "exp_name": "dur_fluency_lstm_bi",
    "model_type": "duration_regressor",
    "batch_size": 64,
    "collate_fn": "pad",
    "model_params": {
      "phone_embed_dim": 16,
      "lstm_bidirectional": true,
      "dropout": 0.2,
      "hidden_size": 32,
      "task": "regression",
      "use_phone_durs_z": false,
      "use_transformer": false,
      "d_model": 64,
      "num_layers": 2,
      "max_len": 64
    },
    "dataset_params": {
      "lmdb_path": "data/speechocean/rtm_feats.lmdb",
      "data_source": "speechocean_custom",
      "items": [
        "v_phones",
        "v_plen",
        "v_phone_durs",
        "v_phone_durs_z",
        "v_dur",
        "c_phones",
        "c_plen",
        "c_phone_durs",
        "c_phone_durs_z",
        "c_dur"
      ],
      "test_size": 0.2,
      "vc_features_path": "data/speechocean/vc_features.json",
      "label_column": "fluency"
    },
    "training_params": {
      "learning_rate": 0.0001,
      "num_epochs": 500,
      "weight_decay": 1e-05,
      "plot_every": 20,
      "save_every": 20,
      "use_early_stopping": true,
      "early_stop_patience": 50
    },

  "hpo": {
      "n_trials": "100",
      "direction": "maximize",
      "pruner": "median",
      "search_space": {
        "training_params.learning_rate": {"type": "categorical", "choices": [1e-4, 5e-4, 1e-3]},
        "training_params.weight_decay":  {"type": "categorical", "choices": [1e-5, 1e-4, 5e-4]},
        "model_params.dropout":          {"type": "categorical", "choices": [0.1, 0.2]},
        "model_params.hidden_size": {"type": "categorical", "choices": [16, 32, 64, 128]},
        "model_params.d_model": {"type": "categorical", "choices": [32, 64, 128]},
        "model_params.phone_embed_dim": {"type": "categorical", "choices": [16, 32]},
        "model_params.lstm_hidden_size": {"type": "categorical", "choices": [32, 64, 128]},
        "model_params.lstm_num_layers": {"type": "categorical", "choices":[1,2]}
      }
    }
}
