{
  "exp_name": "rhythm_encoder_contrastive",
  "collate_fn": "pad",
  "model_params": {
    "feat_dim": 1,
    "kernel_size": 3,
    "cnn_out_channels": 64,
    "num_cnn_layers": 2,
    "lstm_hidden_size": 64,
    "lstm_num_layers": 1,
    "lstm_bidirectional": true,
    "dropout": 0.2,
    "use_text": false,
    "proj_hidden_dim": 128,
    "proj_out_dim": 64,
    "proj_num_layers": 2,
    "proj_dropout": 0.0
  },
  "dataset_params": {
    "lmdb_path": "data/arctic/rtm_feats_bark_f0_egemaps.lmdb",
    "data_source": "arctic_contrastive",
    "items": ["envelope"],
    "phoneme_mapping_path": "data/arctic/phoneme_mapping.json",
    "test_size": 0.05
  },
  "training_params": {
    "learning_rate": 1e-3,
    "num_epochs": 500,
    "weight_decay": 1e-4,
    "temperature": 0.07,
    "utterances_per_batch": 8,
    "l1_per_utterance": 5,
    "l2_per_utterance": 15,
    "use_scheduler": false,
    "monotonicity_coeff": 0.1
  }
}
